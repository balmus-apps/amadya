# Core API reachable from the phone/simulator (Android emulator: http://10.0.2.2:8080/api/v1)
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1
# Public menu-web URL, used to open web checkout when native payments are unavailable
EXPO_PUBLIC_WEB_URL=http://localhost:3000
# White-label build settings (per restaurant)
APP_NAME=BurRegescu
APP_BUNDLE_ID=ro.amadya.burregescu
APP_PRIMARY_COLOR=#FFC400
# Needed for Expo push tokens (development or store builds)
EAS_PROJECT_ID=
