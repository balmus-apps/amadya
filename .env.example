# Copy to .env and change every value marked CHANGE_ME. Never commit .env.

# --- Public URL (Caddy) ---
AMADYA_DOMAIN=localhost

# --- PostgreSQL ---
POSTGRES_DB=amadya
POSTGRES_USER=amadya
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432

# --- MinIO (S3) ---
MINIO_ROOT_USER=amadya
MINIO_ROOT_PASSWORD=CHANGE_ME_min_8_chars
MINIO_BUCKET=amadya

# --- Backend (Phase 1) ---
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=CHANGE_ME_at_least_32_bytes_random
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
