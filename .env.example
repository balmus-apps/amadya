# Copy to .env and change every value marked CHANGE_ME. Never commit .env.

# --- Public URL (Caddy) ---
AMADYA_DOMAIN=localhost

# --- PostgreSQL ---
POSTGRES_DB=amadya
POSTGRES_USER=amadya
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432

# --- MinIO (S3) ---
MINIO_ROOT_USER=amadya
MINIO_ROOT_PASSWORD=CHANGE_ME_min_8_chars
MINIO_BUCKET=amadya

# --- Backend (Phase 1) ---
# dev = demo menu (BurRegescu) + permissive CORS; prod = empty install
SPRING_PROFILES_ACTIVE=dev
API_PORT=8080
# at least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=CHANGE_ME
# first admin, created on an empty database; leave the password empty to get a generated one in the logs
AMADYA_ADMIN_EMAIL=admin@amadya.local
AMADYA_ADMIN_PASSWORD=
# comma-separated browser origins allowed to call the API (prod)
CORS_ALLOWED_ORIGINS=
# fake | stripe (ADR 0007)
PAYMENT_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# log (until printer hardware is chosen, ADR 0003)
PRINTING_MODE=log
# Phase 7 (invoice scan)
ANTHROPIC_API_KEY=
