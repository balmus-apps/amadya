# Copy to .env and change every value marked CHANGE_ME. Never commit .env.

# --- Public URL (Caddy) ---
# Bare host, no scheme. Production (amadya.alphatech.ro, behind repo/proxy):
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml pull
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --no-build
#   Never --build on the server (1 vCPU, 2 GB): images come from GHCR, see docs/deploy.md.
AMADYA_DOMAIN=localhost
# Local only: open the stack to phones on the same Wi-Fi, e.g. http://192.168.1.20 (this machine's address).
# Leave unset on the server.
AMADYA_LAN_SITE=

# --- PostgreSQL ---
POSTGRES_DB=amadya
POSTGRES_USER=amadya
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432

# --- Media (product images, logo) — ADR 0008 ---
# filesystem (Docker volume, default) | s3 (AWS S3, Cloudflare R2, Garage, RustFS, ...)
MEDIA_PROVIDER=filesystem
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=amadya

# --- Backend (Phase 1) ---
# dev = demo menu (Amadya) + permissive CORS; prod = empty install (use prod on the server)
SPRING_PROFILES_ACTIVE=dev
API_PORT=8080
# at least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=CHANGE_ME
# first admin, created on an empty database; leave the password empty to get a generated one in the logs
AMADYA_ADMIN_EMAIL=admin@amadya.local
AMADYA_ADMIN_PASSWORD=
# comma-separated browser origins allowed to call the API (prod)
CORS_ALLOWED_ORIGINS=
# fake | stripe (ADR 0007)
PAYMENT_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# log (until printer hardware is chosen, ADR 0003)
PRINTING_MODE=log
# queue display: a ready order leaves the TV after this long if nobody marks it picked up (e.g. 10m, 30m)
QUEUE_READY_VISIBLE=20m
# Invoice scan: read supplier documents from a photo or PDF with Tesseract OCR on the server
# (Admin → Invoices → New invoice → Import). Free, no external service. Manual entry always works.
INVOICE_SCAN_ENABLED=false
