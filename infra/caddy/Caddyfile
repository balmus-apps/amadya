{
	# Config is never reloaded over the API; the container is restarted instead.
	admin off

	# In production this Caddy sits behind the shared proxy in repo/proxy
	# (docker-compose.prod.yml sets TRUSTED_PROXY_CIDR), so X-Forwarded-For and
	# X-Forwarded-Proto from it are kept: the api sees the real visitor and https.
	# Run on its own (local), the default trusts nothing.
	servers {
		trusted_proxies static {$TRUSTED_PROXY_CIDR:127.0.0.1/32}
	}
}

# AMADYA_LAN_SITE (local only) also serves the stack to phones and tablets on the same network over plain HTTP,
# e.g. http://192.168.1.20. Unset, it is a name nothing resolves.
{$AMADYA_DOMAIN}, {$AMADYA_LAN_SITE} {
	encode zstd gzip

	# Largest legitimate body is an image or an e-Factura upload (api limit 7 MB).
	request_body {
		max_size 8MB
	}

	# Core API (Phase 1): REST, WebSocket (/api/ws), SSE
	handle /api/* {
		reverse_proxy api:8080 {
			# Replace the chain rather than append: {client_ip} is the peer locally
			# and the real visitor behind the shared proxy.
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Staff apps (Phases 3–5)
	redir /admin /admin/
	handle_path /admin/* {
		reverse_proxy admin:80
	}
	# handle_path /waiter/*  { reverse_proxy waiter:80 }
	redir /kitchen /kitchen/
	handle_path /kitchen/* {
		reverse_proxy kitchen:80
	}
	# handle_path /queue/*   { reverse_proxy queue-display:80 }

	# Customer menu is the default site
	handle {
		reverse_proxy menu-web:3000
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
